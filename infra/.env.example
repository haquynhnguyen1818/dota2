# Copy to infra/.env and fill in real values. infra/.env is gitignored.
DB_USER=postgres
DB_PASSWORD=
DB_NAME=dota2
# Comma-separated list of allowed frontend origins, e.g. https://your-app.pages.dev
ALLOWED_ORIGINS=
# Post-draft coach (Phase G). Unlike STRATZ_TOKEN this has no IP binding, so it
# can also be set locally for testing the /coach endpoint outside the Droplet.
ANTHROPIC_API_KEY=
# Master PIN for POST /coach/unlock, once the 5-per-45-min rate limit is hit.
COACH_PIN=
